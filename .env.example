# Copy to .env and fill in — NEVER commit real keys. Maria provides these via secure channel.
PORT=8080

# Public URL of the storefront (for Stripe redirects + CORS)
STORE_URL=https://your-store-url.example
STORE_ORIGIN=https://your-store-url.example

# Catalog source of truth (server validates prices + stock from here).
# Baked into the Docker image as ./products_full.json; override only if needed.
CATALOG_PATH=./products_full.json
DB_PATH=./store.db
VOTE_SALT=cambia-esta-sal-aleatoria

# Ship-from (Maria's business address)
SHIP_FROM_ZIP=79045

# Sales tax (Texas; permit in mail as of 2026-10-06)
TAX_ENABLED=true
TAX_TX_RATE=0.0825

# --- Stripe (Maria opens at stripe.com, Developers -> API keys) ---
STRIPE_SECRET_KEY=sk_live_PON_AQUI_TU_LLAVE
STRIPE_WEBHOOK_SECRET=whsec_PON_AQUI_TU_SECRETO_DEL_WEBHOOK
# Service fee passed to the customer (verify against her real Stripe account)
STRIPE_FEE_RATE=0.029
STRIPE_FEE_FIXED_CENTS=30
# Provisional flat shipping until USPS live rates are connected (0 = keep "Calculated")
SHIP_GROUND_CENTS=0
SHIP_PRIORITY_CENTS=0

# --- USPS (Maria registers at developer.usps.com) ---
USPS_CLIENT_ID=PON_AQUI_TU_CLIENT_ID
USPS_CLIENT_SECRET=PON_AQUI_TU_CLIENT_SECRET

# --- Shippo: compra automática de etiquetas con tarifa comercial USPS ---
# Maria crea la cuenta gratis en shippo.com -> Settings -> API -> token LIVE
SHIPPO_TOKEN=PON_AQUI_TU_TOKEN_DE_SHIPPO
SHIP_FROM_NAME=Andys Shoe Supply
SHIP_FROM_STREET=223 N Greenwood St
SHIP_FROM_CITY=Hereford
SHIP_FROM_STATE=TX
SHIP_FROM_ZIP=79045
SHIP_FROM_PHONE=7025806374
SHIP_FROM_EMAIL=roinelpadin@gmail.com
